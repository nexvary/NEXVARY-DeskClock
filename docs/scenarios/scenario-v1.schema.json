{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexvary:aeroradar:scenario:1",
  "title": "NEXVARY AeroRadar synthetic scenario v1",
  "$comment": "The native loader additionally enforces unique aircraft IDs, vector speed, file size and text normalization constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source", "name", "aircraft"],
  "properties": {
    "format": {"const": "nexvary.aeroradar.scenario"},
    "version": {"const": 1},
    "source": {"const": "synthetic"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "aircraft": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/aircraft"}
    }
  },
  "$defs": {
    "aircraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "x_km", "y_km", "vx_km_s", "vy_km_s", "altitude_m"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"enum": ["fixed-wing", "multirotor"]},
        "x_km": {"type": "number", "minimum": -1000, "maximum": 1000},
        "y_km": {"type": "number", "minimum": -1000, "maximum": 1000},
        "vx_km_s": {"type": "number", "minimum": -2, "maximum": 2},
        "vy_km_s": {"type": "number", "minimum": -2, "maximum": 2},
        "altitude_m": {"type": "number", "minimum": -500, "maximum": 30000}
      }
    }
  }
}
