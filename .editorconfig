# Nexvary AeroRadar — consistent editor defaults across Windows/Linux
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cxx,cc}]
indent_size = 4

[*.qml]
indent_size = 4

[*.{py,js,json}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
